# Copy to .env and fill in. Never commit .env.

# Required
SECRET_KEY=change-me-generate-a-new-one

# Settings module: Smartcop_backend.settings.dev (default for manage.py) or .prod
# DJANGO_SETTINGS_MODULE=Smartcop_backend.settings.dev

# Comma-separated lists. Production rejects "*" and an empty list.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Dev falls back to SQLite when unset; production requires PostgreSQL.
# DATABASE_URL=postgres://user:password@localhost:5432/smartcop
# REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

OPENAI_API_KEY=

# Only while the old frontend still posts /create_complaint/v1 without a user_id.
# LEGACY_DEFAULT_USER_ID=
