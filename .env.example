# Copy to .env and fill in. Never commit .env.

# Required
SECRET_KEY=change-me-generate-a-new-one

# Encrypts Aadhar numbers at rest. Required in production; dev derives one from SECRET_KEY.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=

# Settings module: Smartcop_backend.settings.dev (default for manage.py) or .prod
# DJANGO_SETTINGS_MODULE=Smartcop_backend.settings.dev

# Comma-separated lists. Production rejects "*" and an empty list.
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:8080

# Dev falls back to SQLite when unset; production requires PostgreSQL.
# DATABASE_URL=postgres://user:password@localhost:5432/smartcop
# REDIS_URL=redis://localhost:6379/0

LOG_LEVEL=INFO

# AI providers. Pick the provider and fallback in the AIConfig admin page; set the keys you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Default models, used when AIConfig does not name one.
# OPENAI_MODEL_CLASSIFY=gpt-4
# ANTHROPIC_MODEL_CLASSIFY=claude-sonnet-5-5
# Dollars per million tokens, enables cost tracking and the monthly budget:
# AI_PRICING_JSON={"claude-sonnet-5-5": [3.0, 15.0]}

# Only while the old frontend still posts /create_complaint/v1 without a user_id.
# LEGACY_DEFAULT_USER_ID=
